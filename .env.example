# Supabase project URL — public, baked into the bundle.
# Local dev: http://127.0.0.1:54321 (output of `pnpx supabase status`).
# Production: https://<project-ref>.supabase.co (dashboard → Settings → API).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key — public, baked into the bundle.
# Local dev: printed by `pnpx supabase start` / `pnpx supabase status`.
# Production: dashboard → Settings → API → "anon public".
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...placeholder

# TMDB v3 API key — public per TMDB's intent; carried over from netflix-clone.
VITE_TMDB_API_KEY=your-tmdb-v3-key

# Supabase service-role key — Edge Function only, NEVER imported from src/.
# Set via: pnpx supabase secrets set --env-file supabase/.env.functions
SUPABASE_SERVICE_ROLE_KEY=service-role-jwt-here

# OpenRouter API key — Edge Function only, NEVER imported from src/.
# Set via the same secrets command above.
OPENROUTER_API_KEY=sk-or-...

# OpenRouter model — Edge Function only. v1 locked value.
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Onboarding (local dev):
#   1. cp .env.example .env.local
#   2. pnpx supabase start          # boots Docker stack as project "reel"
#   3. pnpx supabase status         # copy API URL + anon key into .env.local
#   4. pnpm dev
#
# Onboarding (cloud link, when pushing schema/functions later):
#   pnpx supabase link --project-ref <ref>
#   Edge Function secrets:
#     write supabase/.env.functions, then
#     pnpx supabase secrets set --env-file supabase/.env.functions
